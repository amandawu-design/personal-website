---
import { site } from '../data/content';
import SocialIcons from './SocialIcons.astro';
---

<header class="relative z-50 mx-auto max-w-[1200px] px-6 md:px-10" data-site-header>
  <nav class="flex h-[var(--nav-h)] items-center justify-between border-b border-line" aria-label="Main">
    <a href="/" class="flex items-center gap-2 whitespace-nowrap text-[15px] font-medium uppercase tracking-[0.12em]">
      <span class="size-2.5 shrink-0 rounded-full bg-accent"></span>
      {site.name}
    </a>

    <div class="flex items-center gap-3 md:gap-10">
      <ul class="hidden gap-10 text-[16px] md:flex">
        {site.nav.map((item) => (
          <li><a href={item.href} class="transition-opacity hover:opacity-50">{item.label}</a></li>
        ))}
      </ul>

      <button
        type="button"
        class="theme-toggle grid size-10 place-items-center rounded-full transition-colors hover:bg-ink/10"
        aria-label="Toggle dark mode"
        data-theme-toggle
      >
        <!-- moon: shown in light mode -->
        <svg class="icon-moon size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20.5 14.2A8.5 8.5 0 1 1 9.8 3.5a6.8 6.8 0 0 0 10.7 10.7Z" />
        </svg>
        <!-- sun: shown in dark mode -->
        <svg class="icon-sun size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2" />
          <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" />
        </svg>
      </button>

      <button
        type="button"
        class="menu-toggle -mr-2 grid size-10 place-items-center rounded-full transition-colors hover:bg-ink/10 md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span class="menu-icon" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="mobile-menu fixed inset-x-0 bottom-0 flex flex-col bg-paper px-6 pb-10 pt-8 md:hidden"
    data-mobile-menu
    inert
  >
    <ul class="space-y-1">
      {site.nav.map((item) => (
        <li>
          <a href={item.href} class="block py-2 font-serif text-[2.75rem] leading-tight transition-opacity hover:opacity-60" data-menu-link>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
    <SocialIcons size={28} class="mt-auto gap-5" />
  </div>
</header>

<script>
  /* ---------------- Theme toggle ---------------- */
  const themeBtn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const root = document.documentElement;
  const syncTheme = () => {
    const dark = root.classList.contains('dark');
    themeBtn?.setAttribute('aria-pressed', String(dark));
    themeBtn?.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
  };
  const setTheme = (dark: boolean) => {
    root.classList.toggle('dark', dark);
    syncTheme();
    window.dispatchEvent(new CustomEvent('themechange', { detail: { dark } }));
  };
  syncTheme();
  themeBtn?.addEventListener('click', () => setTheme(!root.classList.contains('dark')));
  // Follow the browser if its colour scheme changes while the page is open
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => setTheme(e.matches));

  /* ---------------- Mobile menu ---------------- */
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const menuBtn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');

  if (header && menuBtn && menu) {
    let open = false;

    const setOpen = (next: boolean, restoreFocus = true) => {
      if (next === open) return;
      open = next;
      if (open) {
        // panel starts right under the nav bar, wherever the page is scrolled to
        const navBottom = header.querySelector('nav')!.getBoundingClientRect().bottom;
        menu.style.top = `${Math.max(0, navBottom)}px`;
      }
      header.toggleAttribute('data-menu-open', open);
      menu.inert = !open;
      menuBtn.setAttribute('aria-expanded', String(open));
      menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      root.style.overflow = open ? 'hidden' : '';
      if (open) menu.querySelector<HTMLElement>('a')?.focus({ preventScroll: true });
      else if (restoreFocus) menuBtn.focus({ preventScroll: true });
    };

    menuBtn.addEventListener('click', () => setOpen(!open));
    menu.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => setOpen(false, false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && open) setOpen(false);
    });
    window.matchMedia('(min-width: 48rem)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false, false);
    });
  }
</script>
