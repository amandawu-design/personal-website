---
// Animated concept for the Build case study (payments & capital), in two
// auto-cycling scenarios with the same dash controls as BankPortal:
//   1. Pay at table: on the POS a server picks a table and sends the bill to a
//      countertop reader (styled after the Stripe Reader S700), which lights up;
//      the guest splits the bill (by % then by item), changes the tip, taps to
//      pay and gets a texted receipt; the POS marks the table part-paid.
//   2. Capital: sales are sliding, an AI insight flags a cash crunch and the
//      owner simulates advance amounts and fee rates against projected growth.
// Visual style after lightspeedhq.com/pos/payments/capital (warm black,
// lavender glow, bold grotesk, red CTAs).
//
// Everything is in em (1em = 1/160 of the frame width) so it scales like an
// image; timings are percentages of each scenario's --T.

import { createTimeline, type Point } from '../scripts/timeline';

const { n, kf, on, off, between, press, draw, toast, path, clicks, taps, css } = createTimeline();
const money = (v: number, d = 2) => '$' + v.toLocaleString('en-US', { minimumFractionDigits: d, maximumFractionDigits: d });
const round2 = (v: number) => Math.round(v * 100 + 1e-6) / 100; // cents, with float slack (58.195 → 58.20)

/* ================================================================== */
/* Scenario 1: pay at table (21.5s)                                    */
/* ================================================================== */

const PAY_T = '21.5s'; // ends ~4s after the payment is approved
const TAX = 0.13;
const items = [
  { name: 'Margherita pizza', qty: 2, price: 38 },
  { name: 'Burrata', qty: 1, price: 16 },
  { name: 'Caesar salad', qty: 1, price: 14.5 },
  { name: 'Spaghetti vongole', qty: 1, price: 26 },
  { name: 'Aperol spritz', qty: 2, price: 26 },
  { name: 'Tiramisu', qty: 1, price: 11 },
];
const subtotal = items.reduce((s, i) => s + i.price, 0);
const tax = round2(subtotal * TAX);
const total = round2(subtotal + tax);
const withTax = (v: number) => round2(v * (1 + TAX));
// Guest 1 picks these items (indexes) when splitting by item
const picks = [2, 3, 5];
const guestRunning = picks.map((_, k) => withTax(picks.slice(0, k + 1).reduce((s, i) => s + items[i].price, 0)));
const guest1 = guestRunning.at(-1)!;
const tips = [15, 18, 20].map((p) => ({ p, amount: round2(guest1 * (p / 100)) }));
const tip18 = tips[1].amount;
const tip20 = tips[2].amount;
const paid = round2(guest1 + tip20);
const remaining = round2(total - guest1);

// Desktop cursor (desktop em): table 12, then "Pay at table"
const payCursor: Point[] = [
  [0, 56, 58.5],
  [7.3, 37, 42],
  [10.3, 37, 42],
  [16.9, 91.3, 73.6],
  [20, 91.3, 73.6],
  [26.6, 98, 76],
  [100, 98, 76],
];
// Terminal taps (terminal-screen em)
const segY = 12.3;
const rowY = (i: number) => 16.55 + i * 2.7;
const P = {
  cursor: path('pc-a-cursor', payCursor),
  cursorVis: between(1.2, 27.8),
  clicks: clicks('pc-a-clicks', [9.1, 19.3]),
  empty: off(10.6),
  selected: on(10),
  bill: on(10.6),
  pay: press(19.3),
  // terminal
  glow: on(21.8),
  idle: off(21.8),
  split: between(21.8, 55.6),
  segEven: between(21.8, 31.4),
  segPct: between(31.4, 41.1),
  segItems: on(41.1),
  even: between(21.8, 31.4),
  pct: between(31.4, 41.1),
  byItem: on(41.1),
  checks: [on(44.7), on(47.2), on(49.6)],
  g1: [off(44.7), between(44.7, 47.2), between(47.2, 49.6), on(49.6)],
  cont: press(55),
  tip: between(55.6, 67.7),
  tip18: off(61.7),
  tip20: on(61.7),
  tot18: off(61.7),
  tot20: on(61.7),
  payBtn: press(67.1),
  tap: between(67.7, 79.8),
  // the card slides in, taps the screen, slides away (terminal-body em)
  // a real card is about as wide as the reader: 28 × 17.7em on a 30em-wide body
  card: path('pc-a-card', [
    [0, 48, 30],
    [71.3, 48, 30],
    [75.6, 3, 17.5],
    [77.4, 1, 15.75], // centred on the contactless icon
    [79.8, 3, 17.5],
    [83.4, 48, 30],
    [100, 48, 30],
  ]),
  approved: on(79.8),
  receiptOpts: off(85.3),
  receiptSent: on(85.3),
  taps: taps('pc-a-taps', [
    [31.4, 13.4, segY],
    [41.1, 21.27, segY],
    [44.7, 2.8, rowY(picks[0])],
    [47.2, 2.8, rowY(picks[1])],
    [49.6, 2.8, rowY(picks[2])],
    [55, 13.4, 47],
    [61.7, 7.3, 20.4],
    [67.1, 13.4, 47],
    [84.7, 7.3, 40.2], // "Text" receipt
  ]),
  // desktop after payment
  tableBefore: off(84.7),
  tableAfter: on(84.7),
  paidRow: on(84.7),
  toast: toast(84.7, 95.5),
};

const tables = [
  { id: 10, x: 12, y: 15, state: 'busy', amount: 64.2, meta: '2 guests · 38m' },
  { id: 11, x: 30, y: 15, state: 'free' },
  { id: 14, x: 48, y: 15, state: 'ordering', meta: '3 guests · 5m' },
  { id: 15, x: 12, y: 35, state: 'free' },
  { id: 12, x: 30, y: 35, state: 'busy', amount: total, meta: '4 guests · 1h 12m', target: true },
  { id: 16, x: 48, y: 35, state: 'busy', amount: 37.8, meta: '2 guests · 22m' },
  { id: 20, x: 12, y: 55, state: 'busy', amount: 210.45, meta: '6 guests · 54m' },
  { id: 21, x: 30, y: 55, state: 'free' },
  { id: 22, x: 48, y: 55, state: 'reserved', meta: '8:00 PM' },
];

/* ================================================================== */
/* Scenario 2: capital insights + simulator (26s)                      */
/* ================================================================== */

const CAP_T = '26s';
// Weekly net sales (K) sliding over 12 weeks
const weekly = [47.1, 46.3, 47.8, 45.2, 44.6, 43.1, 42.0, 40.8, 41.3, 39.2, 38.6, 38.2];
const salesPts = weekly.map((v, i) => [n((i / (weekly.length - 1)) * 520 + 10), n(10 + ((49 - v) / (49 - 36)) * 160)] as const);
const salesPath = 'M' + salesPts.map(([x, y]) => `${x} ${y}`).join(' L');
const salesArea = `${salesPath} L${salesPts.at(-1)![0]} 172 L${salesPts[0][0]} 172 Z`;
const drop = Math.round(((weekly.at(-1)! - weekly[0]) / weekly[0]) * 100);
// same weeks last quarter, for the dashed comparison line
const prevWeekly = [45.8, 46.9, 46.2, 47.4, 46.8, 47.9, 47.2, 48.1, 47.5, 48.4, 47.9, 48.6];
const prevPath = 'M' + prevWeekly.map((v, i) => `${n((i / (prevWeekly.length - 1)) * 520 + 10)} ${n(10 + ((49 - v) / (49 - 36)) * 160)}`).join(' L');
const PATIO_WEEK = 5; // the patio closed here (the AI insight refers to it)
const spark = (vals: number[]) => {
  const lo = Math.min(...vals);
  const hi = Math.max(...vals);
  return 'M' + vals.map((v, i) => `${n((i / (vals.length - 1)) * 96 + 2)} ${n(4 + ((hi - v) / (hi - lo || 1)) * 24)}`).join(' L');
};
const metrics = [
  { label: 'Net sales', value: `$${weekly.at(-1)}K`, delta: `${Math.abs(drop)}%`, line: spark(weekly), active: true },
  { label: 'Orders', value: '1,284', delta: '12%', line: spark([1460, 1442, 1471, 1420, 1402, 1390, 1356, 1330, 1342, 1301, 1296, 1284]) },
  { label: 'Average order', value: '$29.75', delta: '8%', line: spark([32.3, 32.1, 32.5, 31.8, 31.6, 31.0, 30.9, 30.6, 30.8, 30.1, 29.9, 29.75]) },
  { label: 'Returning guests', value: '31%', delta: '4 pts', line: spark([35, 35, 34.5, 34, 34, 33.2, 33, 32.4, 32.6, 31.8, 31.4, 31]) },
];
const nav = [
  { label: 'Home', d: 'M4 11l8-6 8 6v8a1 1 0 0 1-1 1h-4v-6H9v6H5a1 1 0 0 1-1-1z' },
  { label: 'Orders', d: 'M6 3h12v18l-3-2-3 2-3-2-3 2zM9 8h6M9 12h6', badge: '12' },
  { label: 'Menu items', d: 'M4 7l8-4 8 4-8 4zM4 7v10l8 4 8-4V7' },
  { label: 'Guests', d: 'M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM3 20a6 6 0 0 1 12 0M16 5a3 3 0 0 1 0 6M18 14a5 5 0 0 1 3 6' },
  { label: 'Analytics', d: 'M4 20V10M10 20V4M16 20v-7M22 20H2' },
  { label: 'Payments', d: 'M3 6h18v12H3zM3 10h18' },
  { label: 'Capital', d: 'M12 3v18M16 7H10a3 3 0 0 0 0 6h4a3 3 0 0 1 0 6H7', badge: 'New' },
];

// Cash balance outlook (K) dipping below zero
const cash = [18.4, 16.9, 14.2, 12.8, 10.1, 7.6, 5.9, 3.2, 1.1, -1.8, -3.9, -5.2];
const cashY = (v: number) => n(10 + ((20 - v) / 28) * 135);
const cashPts = cash.map((v, i) => [n((i / (cash.length - 1)) * 540 + 10), cashY(v)] as const);
const cashPath = 'M' + cashPts.map(([x, y]) => `${x} ${y}`).join(' L');

// Simulator model: $5K–$60K slider, remit 12% of ~$40K monthly sales
const MIN = 5000;
const MAX = 60000;
const REMIT = 0.12 * 40000;
const lift = (a: number) => a * 2.6 * (1 - a / 160000); // 12-month revenue lift, diminishing
const states = [
  { key: 'a', amount: 10000, rate: 0.1 },
  { key: 'b', amount: 25000, rate: 0.1 },
  { key: 'c', amount: 50000, rate: 0.1 },
  { key: 'd', amount: 50000, rate: 0.12 },
  { key: 'e', amount: 50000, rate: 0.08 },
  { key: 'f', amount: 25000, rate: 0.08 },
].map((s) => {
  const repay = s.amount * (1 + s.rate);
  const L = lift(s.amount);
  // monthly revenue: baseline slides 1.5%/mo; the advance adds a ramping lift
  const months = Array.from({ length: 13 }, (_, m) => m);
  const ramp = months.map((m) => (m === 0 ? 0 : 1 - Math.exp(-m / 3)));
  const rampSum = ramp.reduce((a, b) => a + b, 0);
  const base = months.map((m) => 42000 * 0.985 ** m);
  const withCap = months.map((m) => base[m] + (L * ramp[m]) / rampSum);
  return { ...s, repay, payback: repay / REMIT, lift: L, base, withCap };
});
const yRev = (v: number) => n(10 + ((52000 - v) / (52000 - 32000)) * 190);
const topItems = [
  { name: 'Spaghetti vongole', sold: 164, sales: 4264 },
  { name: 'Margherita pizza', sold: 212, sales: 4028 },
  { name: 'Aperol spritz', sold: 301, sales: 3913 },
  { name: 'Tiramisu', sold: 188, sales: 2068 },
  { name: 'Burrata', sold: 121, sales: 1936 },
];
const expenses = [
  { name: 'Payroll', when: 'Nov 15', amount: 14200 },
  { name: 'Holiday inventory', when: 'Nov 20', amount: 9800 },
  { name: 'Utilities', when: 'Nov 28', amount: 2100 },
  { name: 'Rent', when: 'Dec 1', amount: 6500 },
];
const xMonth = (m: number) => n(46 + (m / 12) * 780);
const linePath = (vals: number[]) => 'M' + vals.map((v, m) => `${xMonth(m)} ${yRev(v)}`).join(' L');
const basePath = linePath(states[0].base);
const statePaths = states.map((s) => {
  const fee = s.amount * s.rate;
  const advShare = (s.amount / s.repay) * 100;
  return {
    ...s,
    fee,
    d: linePath(s.withCap),
    area: `${linePath(s.withCap)} L${xMonth(12)} ${yRev(32000)} L${xMonth(0)} ${yRev(32000)} Z`,
    // "Your offer" ring (pathLength 100) and payback timeline (Nov → Jun = 8 months)
    advArc: n(advShare - 0.8),
    feeArc: n(100 - advShare - 0.8),
    feeOffset: n(-advShare),
    paidPct: n(Math.min(100, (s.payback / 8) * 100)),
    liftPerFeeDollar: n(s.lift / fee),
  };
});
const months = ['Nov', 'Dec', 'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'];

// Admin layout (after Shopify's new admin): dark sidebar 0–16.8em, white main panel
// inset 0.8em (so panel em + 16.8 / + 0.8 = desktop em). The AI insight opens between
// the dashboard rows; "Simulate funding" then opens the Capital page. Cursor targets
// below are desktop em on that page.
const PANEL = { x: 16.8, y: 0.8 };
const BUILDER = { x: 3, y: 12.4, pad: 2.6 }; // offer builder card (panel em)
const TRACK_X = PANEL.x + BUILDER.x + BUILDER.pad;
const TRACK_W = 64.8;
const thumbX = (a: number) => TRACK_X + ((a - MIN) / (MAX - MIN)) * TRACK_W;
const final = states.at(-1)!;
const TRACK_Y = PANEL.y + BUILDER.y + 14.7;
const RATE_Y = PANEL.y + BUILDER.y + 23.4;
const rateX = { 0.08: TRACK_X + 6, 0.1: TRACK_X + 19.6, 0.12: TRACK_X + 33.2 } as Record<number, number>; // 12em pills, 1.6em gaps
const REQ = [PANEL.x + 119.4 - 8.5, PANEL.y + 5.8] as const; // "Request" button in the page header
const SIMULATE = [126, 56.9] as const; // "Simulate funding" button centre on the dashboard
const DONE = [72, 61.8] as const; // "Done" button in the confirmation modal
const capCursor: Point[] = [
  [0, 100, 62],
  [14, SIMULATE[0], SIMULATE[1]],
  [17, SIMULATE[0], SIMULATE[1]],
  [22, thumbX(10000), TRACK_Y],
  [23, thumbX(10000), TRACK_Y],
  [29, thumbX(25000), TRACK_Y],
  [34, thumbX(50000), TRACK_Y],
  [35, thumbX(50000), TRACK_Y],
  [39, rateX[0.12], RATE_Y],
  [41, rateX[0.12], RATE_Y],
  [44, rateX[0.08], RATE_Y],
  [46, rateX[0.08], RATE_Y],
  [49, thumbX(50000), TRACK_Y],
  [50, thumbX(50000), TRACK_Y],
  [55, thumbX(25000), TRACK_Y],
  [56, thumbX(25000), TRACK_Y],
  [61, REQ[0], REQ[1]],
  [63, REQ[0], REQ[1]],
  [69, 104, 68],
  [83, 104, 68],
  [87.5, DONE[0], DONE[1]],
  [90, DONE[0], DONE[1]],
  [95, 112, 70],
  [100, 112, 70],
];
const thumbOffset = (a: number) => `translateX(${n(thumbX(a) - thumbX(final.amount))}em)`;
const fillScale = (a: number) => `scaleX(${n((a - MIN) / (final.amount - MIN))})`;
const stateWindows: [number, number][] = [
  [0, 26],
  [26, 31.5],
  [31.5, 40],
  [40, 45],
  [45, 52.5],
  [52.5, 100],
];
const windowAnim = ([a, b]: [number, number]) => (a === 0 ? off(b) : b === 100 ? on(a) : between(a, b));
const C = {
  cursor: path('pc-b-cursor', capCursor),
  cursorVis: between(1, 96),
  clicks: clicks('pc-b-clicks', [16, 40, 45, 62, 89]),
  sales: draw(1, 8),
  salesArea: on(6),
  // the insight opens between the rows; the bottom row slides down to make room
  insight: kf('pc-b-insight', '0%,8%{opacity:0;transform:translateY(-1em) scale(.985)}10.5%,100%{opacity:1;transform:none}'),
  rowD: kf('pc-b-rowd', '0%,8%{transform:none}10.5%,100%{transform:translateY(13.8em)}'),
  // "Simulate funding" opens the Capital page: the dashboard slides out, the page slides in
  dashOut: kf('pc-b-dash', '0%,17.5%{opacity:1;transform:none}19.5%,100%{opacity:0;transform:translateX(-4em)}'),
  pageIn: kf('pc-b-page', '0%,18%{opacity:0;transform:translateX(4em)}20.5%,100%{opacity:1;transform:none}'),
  cards: [19, 19.8, 20.6].map((p, i) =>
    kf(`pc-b-card${i}`, `0%,${p}%{opacity:0;transform:translateY(1.6em)}${n(p + 2.2)}%,100%{opacity:1;transform:none}`),
  ),
  ringIn: kf('pc-b-ring', '0%,20%{transform:rotate(-120deg) scale(.7);opacity:0}23%,100%{transform:none;opacity:1}'),
  navAnalytics: off(18.5),
  navCapital: on(18.5),
  lines: [on(9.5), on(11), on(12.5)],
  simulate: press(16),
  windows: stateWindows.map(windowAnim),
  rate10: off(40),
  rate12: between(40, 45),
  rate8: on(45),
  request: press(62),
  // "Request" opens a confirmation modal over the page; "Done" closes it
  scrim: kf('pc-b-scrim', '0%,62.5%{opacity:0}64.5%,90%{opacity:1}92%,100%{opacity:0}'),
  modal: kf(
    'pc-b-modal',
    '0%,63%{opacity:0;transform:translate(-50%,-46%) scale(.96)}65.5%,90%{opacity:1;transform:translate(-50%,-50%)}92%,100%{opacity:0;transform:translate(-50%,-48%) scale(.98)}',
  ),
  modalOk: kf('pc-b-modal-ok', '0%,65%{opacity:0;transform:scale(.4)}67.5%{opacity:1;transform:scale(1.08)}69.5%,100%{opacity:1;transform:none}'),
  done: press(89),
};
// thumb + fill follow the drags (offsets relative to the final $25K spot)
const transforms = (name: string, frames: [number, string][]) => kf(name, frames.map(([p, t]) => `${p}%{transform:${t}}`).join(''));
const thumbMove = transforms('pc-b-thumbmove', [
  [0, thumbOffset(10000)],
  [23, thumbOffset(10000)],
  [29, thumbOffset(25000)],
  [34, thumbOffset(50000)],
  [50, thumbOffset(50000)],
  [55, 'none'],
  [100, 'none'],
]);
const fillMove = transforms('pc-b-fillmove', [
  [0, fillScale(10000)],
  [23, fillScale(10000)],
  [29, fillScale(25000)],
  [34, fillScale(50000)],
  [50, fillScale(50000)],
  [55, 'none'],
  [100, 'none'],
]);

const scenes = [
  {
    key: 'pay',
    tab: 'Pay at table',
    T: PAY_T,
    label: `Animated concept: on the POS, a server selects table 12 and sends the ${money(total)} bill to a handheld payment terminal. The terminal lights up, the guest splits the bill by percentage and then by item, changes the tip to 20% and taps a card. The terminal approves the payment and texts a receipt, and the POS shows ${money(remaining)} left on the table.`,
  },
  {
    key: 'capital',
    tab: 'Capital',
    T: CAP_T,
    label: `Animated concept: the POS shows net sales down ${Math.abs(drop)}% over 12 weeks. An AI insight warns that cash could run short and suggests an advance. The owner opens a capital simulator, compares advances from $10,000 to $50,000 and fee rates from 8% to 12% against projected revenue, and requests $25,000 at 8%.`,
  },
];

const a = (name: string) => `--a:${name}`;
const generatedCss = css();
---

<div class="pc-root" data-pos-capital data-scene="pay">
  <div class="pc" role="img" aria-label={scenes[0].label} data-pc-frame>
    <div class="pc-stage" aria-hidden="true">
      <!-- ============================================================ -->
      <!-- Scenario 1: pay at table                                      -->
      <!-- ============================================================ -->
      <div class="pc-scene pc-scene-pay" style={`--T:${PAY_T}`}>
        <div class="pc-desktop pc-desktop-pay">
          <div class="pc-side"><span class="pc-mark"></span><i></i><i class="is-on"></i><i></i><i></i></div>
          <div class="pc-top">
            <p class="pc-title">Dining room</p>
            <span class="pc-chip is-on">Main</span><span class="pc-chip">Patio</span><span class="pc-chip">Bar</span>
            <span class="pc-top-end"><span class="pc-muted">7:42 PM</span><span class="pc-avatar"><span>MJ</span></span></span>
          </div>
          <div class="pc-floor"></div>
          {tables.map((t) => (
            <div class:list={['pc-table', `is-${t.state}`]} style={`left:${t.x}em;top:${t.y}em`}>
              <span class="pc-table-id">{t.id}</span>
              {t.state === 'busy' && !t.target && <span class="pc-table-amt">{money(t.amount!)}</span>}
              {t.target && (
                <span class="pc-table-amt pc-swap">
                  <span class="pc-a" style={a(P.tableBefore)}>{money(total)}</span>
                  <span class="pc-a pc-hide pc-green" style={a(P.tableAfter)}>{money(remaining)} left</span>
                </span>
              )}
              {t.state === 'free' && <span class="pc-table-meta">Free</span>}
              {t.state === 'ordering' && <span class="pc-table-amt">Ordering</span>}
              {t.state === 'reserved' && <span class="pc-table-amt">Reserved</span>}
              {t.meta && <span class="pc-table-meta">{t.meta}</span>}
              {t.target && <span class="pc-table-ring pc-a" style={a(P.selected)}></span>}
              {t.target && <span class="pc-table-badge pc-a pc-hide" style={a(P.paidRow)}>1 of 2 paid</span>}
            </div>
          ))}

          <div class="pc-panel">
            <p class="pc-empty pc-a pc-hide" style={a(P.empty)}>Select a table to see its bill</p>
            <div class="pc-bill pc-a" style={a(P.bill)}>
              <p class="pc-bill-title">Table 12</p>
              <p class="pc-muted pc-small">4 guests · Server: Maya · 1h 12m</p>
              <div class="pc-lines">
                {items.map((i) => (
                  <div class="pc-line">
                    <span><b>{i.qty}×</b> {i.name}</span>
                    <span>{money(i.price)}</span>
                  </div>
                ))}
              </div>
              <div class="pc-line pc-muted"><span>Subtotal</span><span>{money(subtotal)}</span></div>
              <div class="pc-line pc-muted"><span>Tax (13%)</span><span>{money(tax)}</span></div>
              <div class="pc-line pc-total"><span>Total</span><span>{money(total)}</span></div>
              <div class="pc-paid pc-a pc-hide" style={a(P.paidRow)}>
                <div class="pc-line pc-green"><span>✓ Guest 1 · Visa •• 4821</span><span>{money(paid)}</span></div>
                <div class="pc-line pc-total"><span>Remaining</span><span>{money(remaining)}</span></div>
              </div>
              <div class="pc-actions">
                <span class="pc-btn pc-outline">Print bill</span>
                <span class="pc-btn pc-red pc-a" style={a(P.pay)}>Pay at table</span>
              </div>
            </div>
          </div>

          <div class="pc-toast pc-a pc-hide" style={a(P.toast)}>
            <span class="pc-toast-icon"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></span>
            <span class="pc-toast-text"><b>Payment approved · Table 12</b><span>Guest 1 paid {money(paid)} incl. {money(tip20)} tip</span></span>
          </div>

