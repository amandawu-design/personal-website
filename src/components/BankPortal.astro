    top: 2.8em; /* 12.3em */
    justify-items: start;
    font-family: var(--font-serif);
    font-size: 4.4em;
    line-height: 1;
    color: var(--ink);
  }
  .bp-slider {
    position: absolute;
    left: 0;
    right: 0;
    top: 20em;
    height: 0.6em;
    border-radius: 1em;
    background: var(--track);
  }
  .bp-slider-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 53.33%;
    border-radius: 1em;
    background: var(--lime);
    transform-origin: left;
  }
  .bp-slider-thumb {
    position: absolute;
    left: calc(53.33% - 1.3em);
    top: -1em;
    width: 2.6em;
    height: 2.6em;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0.2em 0.6em rgb(0 0 0 / 0.2), 0 0 0 0.35em var(--lime-soft);
  }
  .bp-slider-scale {
    position: absolute;
    left: 0;
    right: 0;
    top: 22.4em;
    display: flex;
    justify-content: space-between;
    font-size: 1em;
    color: var(--muted);
  }
  .bp-cats-head {
    position: absolute;
    left: 0;
    right: 0;
    top: 24.2em; /* 26.6em */
    font-size: 1.1em;
  }
  .bp-cats-head .bp-overline {
    font-size: 0.9em;
  }
  .bp-cats {
    position: absolute;
    left: 0;
    right: 0;
    top: 30em;
  }
  .bp-cat {
    display: grid;
    grid-template-columns: auto 10em 1fr 4em;
    align-items: center;
    height: 4.4em;
    border-bottom: 1px solid var(--line);
  }
  .bp-cat-name {
    font-size: 1.25em;
    font-weight: 500;
    color: var(--ink);
  }
  .bp-cat-bar {
    display: block;
    height: 0.7em;
    overflow: hidden;
    border-radius: 1em;
    background: var(--subtle);
  }
  .bp-cat-bar > span {
    display: block;
    height: 100%;
    border-radius: 1em;
    background: var(--c);
    transform-origin: left;
  }
  .bp-cat-amt {
    text-align: right;
    font-size: 1.25em;
    font-weight: 600;
    color: var(--ink);
  }
  .bp-budget-actions {
    position: absolute;
    left: 0;
    right: 0;
    top: 51em;
    display: flex;
    align-items: center;
    gap: 1.2em;
    height: 3.6em;
  }
  .bp-switch {
    position: relative;
    flex: none;
    width: 4.4em;
    height: 2.4em;
    border-radius: 2em;
    background: var(--switch-off);
  }
  .bp-switch-on {
    position: absolute;
    inset: 0;
    border-radius: 2em;
    background: var(--lime);
  }
  .bp-switch-knob {
    position: absolute;
    top: 0.25em;
    left: 2.25em;
    width: 1.9em;
    height: 1.9em;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0.1em 0.3em rgb(0 0 0 / 0.2);
  }
  .bp-switch-label {
    font-size: 1.25em;
    margin-right: auto;
  }
  .bp-save {
    width: 11.2em; /* 14em at this font size */
    padding: 0.75em 0;
    font-size: 1.25em;
  }

  /* Budget: side card */
  .bp-side-card {
    left: 65.6em;
    width: 34.8em;
    padding-left: 3em;
    border-left: 1px solid var(--line);
  }
  .bp-goal {
    margin: 1.6em 0 0.4em;
  }
  .bp-goal .bp-row {
    margin-bottom: 0.7em;
    font-size: 1.25em;
  }
  .bp-side-card .bp-overline {
    margin-top: 2.2em !important;
  }
  .bp-overline {
    padding-bottom: 0.4em;
    font-size: 1em;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .bp-rule {
    height: 3.4em;
    border-bottom: 1px solid var(--line);
    font-size: 1.2em;
  }
  .bp-rule > * {
    font-size: inherit;
  }
  .bp-rule > b {
    display: flex;
    align-items: center;
    gap: 0.3em;
  }
  .bp-chev {
    width: 1.1em;
    height: 1.1em;
    fill: none;
    stroke: var(--muted);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .bp-txn {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }
  .bp-txn span {
    font-size: 0.8em;
    color: var(--muted);
  }
  .bp-rule:has(.bp-txn) {
    height: 4.2em;
  }
  .bp-switch-static {
    font-size: 0.83em;
  }

  /* Trade: chart column */
  .bp-chart-card {
    left: 3.6em;
    width: 61em;
  }
  .bp-chart-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
  }
  .bp-sym {
    display: flex;
    align-items: center;
    gap: 0.5em;
    font-size: 1.3em;
  }
  .bp-sym > span:last-child {
    color: var(--muted);
  }
  .bp-ticker {
    display: grid;
    place-items: center;
    width: 1.7em;
    height: 1.7em;
    margin-right: 0.15em;
    border-radius: 0.45em;
    background: var(--lime);
    font-size: 0.9em;
    font-weight: 700;
    color: var(--on-pastel);
  }
  .bp-price {
    margin-top: 0.35em !important;
    font-family: var(--font-serif);
    font-size: 3.4em;
    font-weight: 500;
    line-height: 1.1;
    color: var(--ink);
  }
  .bp-price small {
    margin-left: 0.35em;
    font-family: var(--font-sans);
    font-size: 0.3em;
    font-weight: 500;
    color: var(--muted);
  }
  .bp-change {
    margin-top: 0.2em !important;
    font-size: 1.2em;
    font-weight: 600;
    color: var(--pos);
  }
  .bp-seg {
    position: absolute;
    left: 0;
    top: 49em;
    display: flex;
    gap: 0.3em;
  }
  .bp-seg span {
    padding: 0.35em 0.85em;
    border-radius: 2em;
    font-size: 1.1em;
    font-weight: 600;
    color: var(--muted);
  }
  .bp-seg .is-on {
    background: var(--subtle);
    color: var(--ink);
  }
  .bp-details {
    position: absolute;
    left: 0;
    right: 6em;
    top: 52.6em;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.6em 2em;
  }
  .bp-details-title {
    grid-column: 1 / -1;
    font-size: 1.2em;
    font-weight: 600;
    color: var(--ink);
  }
  .bp-details p:not(.bp-details-title) {
    display: flex;
    flex-direction: column;
    font-size: 1.1em;
  }
  .bp-details b {
    font-weight: 500;
  }
  .bp-chips {
    display: flex;
    gap: 0.6em;
  }
  .bp-chip {
    display: flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.3em 0.8em;
    border: 1px solid var(--line);
    border-radius: 2em;
    font-size: 1.05em;
  }
  .bp-swatch {
    display: inline-block;
    width: 0.9em;
    height: 0.22em;
    border-radius: 1em;
    background: var(--strong);
  }
  .bp-svg {
    position: absolute;
    left: 0;
    top: 12em;
    width: 61em;
  }
  .bp-gridline {
    stroke: var(--line);
    stroke-width: 1;
  }
  .bp-axis {
    font-family: var(--font-sans);
    font-size: 10px;
    fill: var(--muted);
  }
  .bp-candle line {
    stroke-width: 1.2;
  }
  .bp-candle.is-up line {
    stroke: var(--up);
  }
  .bp-candle.is-up rect {
    fill: var(--up);
  }
  .bp-candle.is-down line {
    stroke: var(--down);
  }
  .bp-candle.is-down rect {
    fill: var(--down);
  }
  .bp-vol {
    opacity: 0.25;
  }
  .bp-vol.is-up {
    fill: var(--up);
  }
  .bp-vol.is-down {
    fill: var(--down);
  }
  .bp-ma {
    fill: none;
    stroke: var(--strong);
    stroke-width: 1.5;
    stroke-linejoin: round;
    opacity: 0.8;
  }
  .bp-root[data-play] .bp-candle,
  .bp-root[data-play] .bp-vol {
    transform-box: fill-box;
    transform-origin: center bottom;
    animation: bp-rise 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) calc(var(--i) * 25ms) both;
  }

  /* Order lines over the chart (overlay origin = plot origin; 55em wide plot, tags to the right) */
  .bp-overlay {
    position: absolute;
    left: 0;
    top: 12em;
    width: 55em;
    height: 34.6em;
  }
  .bp-level {
    position: absolute;
    left: 0;
    width: 55em;
    height: 0;
    border-top: 0.15em dashed var(--c);
  }
  .bp-level-last {
    --c: var(--level-last);
  }
  .bp-level-buy {
    --c: var(--strong);
    --on-c: var(--on-strong);
    z-index: 2;
  }
  .bp-level-tp {
    --c: var(--pos);
  }
  .bp-level-sl {
    --c: var(--down);
  }
  .bp-level > span {
    position: absolute;
    top: 0;
    transform: translateY(-50%);
    white-space: nowrap;
  }
  .bp-label {
    left: 1em;
    padding: 0.25em 0.7em;
    border-radius: 0.5em;
    background: var(--c);
    color: var(--on-c, #fff);
    font-size: 1em;
    font-weight: 600;
  }
  .bp-pnl {
    left: 12em;
    padding: 0.2em 0.6em;
    border-radius: 0.5em;
    background: var(--surface);
    border: 1px solid var(--c);
    color: var(--c);
    font-size: 1em;
    font-weight: 600;
  }
  .bp-tag {
    left: 55em;
    padding: 0.25em 0.5em;
    border-radius: 0.4em;
    background: var(--c);
    color: var(--on-c, #fff);
    font-size: 0.95em;
    font-weight: 600;
  }
  .bp-level-last .bp-tag {
    color: var(--on-pastel);
  }
  .bp-handle {
    width: 4.6em;
    padding: 0.25em 0;
    border: 1px solid var(--strong);
    border-radius: 0.5em;
    background: var(--surface);
    text-align: center;
    font-size: 1em;
    font-weight: 600;
    color: var(--strong);
  }
  .bp-zone {
    position: absolute;
    left: 0;
    width: 55em;
  }
  .bp-zone-tp {
    background: rgb(108 194 31 / 0.1);
  }
  .bp-zone-sl {
    background: rgb(223 91 69 / 0.1);
  }
  .bp-vline,
  .bp-hline {
    position: absolute;
    left: 0;
    top: 0;
    border: 0 dashed var(--strong);
    opacity: 0.55;
  }
  .bp-vline {
    height: 34.6em;
    border-left-width: 0.12em;
  }
  .bp-hline {
    width: 55em;
    border-top-width: 0.12em;
  }

  /* Trade: order ticket */
  .bp-order {
    left: 67.6em; /* keep PLACE_X / PLACE_Y in the frontmatter in sync */
    width: 32.8em;
    padding-left: 3em;
    border-left: 1px solid var(--line);
    display: flex;
    flex-direction: column;
  }
  .bp-order .bp-toggle {
    margin: 1.4em 0 0.6em;
  }
  .bp-toggle {
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding: 0.35em;
    border-radius: 1.2em;
    background: var(--subtle);
  }
  .bp-toggle span {
    padding: 0.45em 0;
    border-radius: 0.8em;
    text-align: center;
    font-size: 1.2em;
    font-weight: 600;
    color: var(--muted);
  }
  .bp-toggle .is-on {
    background: var(--strong);
    color: var(--on-strong);
  }
  .bp-field,
  .bp-total {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 1.15em;
  }
  .bp-field {
    padding: 0.95em 0;
    border-bottom: 1px solid var(--line);
  }
  .bp-total {
    padding-top: 1.1em;
  }
  .bp-est {
    padding-top: 0.6em;
  }
  .bp-field i,
  .bp-total i {
    margin-left: 0.3em;
    font-size: 0.9em;
  }
  .bp-place {
    margin-top: 1.8em;
    padding: 0.8em;
    font-size: 1.3em;
  }
  .bp-order-note {
    margin-top: 1.1em !important;
    text-align: center;
    font-size: 1em;
  }

  /* ---------------- Phone ---------------- */
  .bp-phone {
    position: absolute;
    left: 101.34em; /* 113.5em of the frame at this font size */
    top: 6.79em;
    width: 30em;
    height: 63.6em; /* ≈ iPhone 16 proportions */
    font-size: 1.12em;
    padding: 0.9em;
    border-radius: 4.8em;
    background: #1d1b16;
    box-shadow: 0 2.4em 5em rgb(40 40 20 / 0.25);
  }
  .bp-screen {
    position: relative;
    height: 100%;
    overflow: hidden;
    border-radius: 4em;
    background: var(--app);
  }
  .bp-status {
    position: absolute;
    left: 0;
    right: 0;
    top: 1em;
    z-index: 6;
    display: flex;
    justify-content: center;
  }
  .bp-home {
    position: absolute;
    left: 50%;
    bottom: 0.8em;
    z-index: 6;
    width: 11em;
    height: 0.42em;
    margin-left: -5.5em;
    border-radius: 1em;
    background: var(--ink);
    opacity: 0.85;
  }
  .bp-island {
    width: 8em;
    height: 2.3em;
    border-radius: 2em;
    background: #1d1b16;
  }
  .bp-tap {
    position: absolute;
    left: -2em;
    top: -2em;
    z-index: 7;
    width: 4em;
    height: 4em;
    border-radius: 50%;
    background: rgb(39 29 3 / 0.35);
    box-shadow: 0 0 0 0.3em rgb(255 255 255 / 0.6);
  }

  /* Lock screen */
  .bp-lock {
    position: absolute;
    inset: 0;
    padding: 9em 2em 0;
    text-align: center;
    background:
      radial-gradient(circle at 20% 85%, rgb(134 220 42 / 0.35), transparent 45%),
      radial-gradient(circle at 85% 30%, rgb(185 182 240 / 0.45), transparent 50%),
      linear-gradient(180deg, var(--lock-a), var(--lock-b));
  }
  .bp-lock-date {
    font-size: 1.3em;
    font-weight: 500;
    color: var(--strong);
  }
  .bp-lock-time {
    font-size: 7em;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .bp-live {
    margin-top: 18em;
    padding: 1.4em 1.6em;
    border-radius: 2em;
    background: var(--glass);
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 0.9em;
  }
  .bp-live-sym {
    display: flex;
    align-items: center;
    gap: 0.6em;
    font-size: 1.2em;
  }
  .bp-live-sym .bp-app-icon {
    width: 2em;
    height: 2em;
    border-radius: 0.6em;
  }
  .bp-live-price {
    font-size: 1.4em;
  }
  .bp-live > .bp-row.bp-muted {
    font-size: 0.95em;
  }

  /* Notification banner */
  .bp-banner {
    position: absolute;
    left: 1.2em;
    right: 1.2em;
    top: 4.4em;
    z-index: 5;
    display: flex;
    gap: 1em;
    padding: 1.2em;
    border-radius: 2em;
    background: var(--glass-strong);
    box-shadow: 0 1em 2.4em rgb(40 40 20 / 0.18);
  }
  .bp-banner-text {
    display: flex;
    flex-direction: column;
    gap: 0.2em;
    font-size: 1.05em;
    line-height: 1.3;
  }
  .bp-banner-text b {
    font-size: 1.05em;
  }
  .bp-banner-app {
    font-size: 0.85em;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* App screens (open over the lock screen) */
  .bp-app {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 1em;
    padding: 4.6em 2em 2em;
    background: var(--app);
  }
  .bp-app-head {
    display: flex;
    align-items: center;
    gap: 0.5em;
    margin-left: -0.4em;
  }
  .bp-app-title {
    font-family: var(--font-serif);
    font-size: 2.3em;
    font-weight: 500;
    color: var(--ink);
  }
  .bp-center {
    text-align: center;
    font-size: 1.1em;
  }
  .bp-ring {
    position: relative;
    width: 15em;
    height: 15em;
    margin: 0.6em auto 0;
  }
  .bp-ring svg {
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }
  .bp-ring circle {
    fill: none;
    stroke-width: 11;
  }
  .bp-ring-track {
    stroke: var(--track);
  }
  .bp-ring-arc {
    stroke: var(--lime);
    stroke-linecap: round;
    stroke-dasharray: 1;
  }
  .bp-ring-text {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .bp-ring-text b {
    font-family: var(--font-serif);
    font-size: 3.6em;
    font-weight: 500;
    line-height: 1;
  }
  .bp-ring-text span {
    font-size: 1em;
    color: var(--muted);
  }
  .bp-m-cats {
    display: flex;
    flex-direction: column;
    gap: 1em;
    padding: 1.2em 0 0.4em;
    border-top: 1px solid var(--line);
  }
  .bp-m-cat .bp-row {
    margin-bottom: 0.4em;
    font-size: 1.1em;
  }
  .bp-m-cat .bp-row > span {
    display: flex;
    align-items: center;
  }
  .bp-m-cat .bp-cat-bar {
    height: 0.55em;
  }
  .bp-note {
    display: flex;
    align-items: center;
    gap: 1em;
    padding: 1.1em 1.3em;
    border-radius: 1.6em;
    background: var(--lime-soft);
  }
  .bp-note .bp-face {
    width: 3.4em;
    height: 3.4em;
  }
  .bp-note .bp-face > span {
    font-size: 1em;
  }
  .bp-note > span:last-child {
    display: flex;
    flex-direction: column;
    font-size: 1.05em;
  }

  /* Trade result screen */
  .bp-m-sym {
    font-size: 1.1em;
  }
  .bp-gain {
    margin-top: -0.2em !important;
    font-family: var(--font-serif);
    font-size: 5em;
    font-weight: 500;
    line-height: 1;
    color: var(--gain);
  }
  .bp-gain-pct {
    font-size: 1.2em;
    font-weight: 600;
    color: var(--pos);
  }
  .bp-mini {
    width: 100%;
    height: auto;
    margin: 0.4em 0;
    overflow: visible;
  }
  .bp-mini-tp,
  .bp-mini-entry {
    stroke-dasharray: 4 4;
    stroke-width: 1.2;
  }
  .bp-mini-tp {
    stroke: var(--pos);
  }
  .bp-mini-entry {
    stroke: var(--level-last);
  }
  .bp-mini-line {
    fill: none;
    stroke: var(--strong);
    stroke-width: 2.4;
    stroke-linejoin: round;
    stroke-dasharray: 1;
  }
  .bp-mini-dot {
    fill: var(--lime);
    stroke: var(--strong);
    stroke-width: 2;
  }
  .bp-rows {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--line);
  }
  .bp-rows .bp-row {
    height: 3.1em;
    font-size: 1.15em;
    border-bottom: 1px solid var(--line);
  }
  .bp-rows .bp-row:last-child {
    border-bottom: 0;
  }
  .bp-share,
  .bp-send {
    margin-top: auto;
    padding: 0.8em;
    font-size: 1.35em;
  }

  /* Share sheet */
  .bp-scrim {
    position: absolute;
    inset: 0;
    z-index: 3;
    background: rgb(29 27 22 / 0.35);
  }
  .bp-sheet {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 4;
    display: flex;
    flex-direction: column;
    gap: 1em;
    height: 36em;
    padding: 1em 2em 2em;
    border-radius: 2.6em 2.6em 0 0;
    background: var(--app);
    transform: translateY(100%);
  }
  .bp-grabber {
    align-self: center;
    width: 4em;
    height: 0.45em;
    border-radius: 1em;
    background: var(--grabber);
  }
  .bp-sheet-title {
    font-family: var(--font-serif);
    font-size: 2em;
    font-weight: 500;
    color: var(--ink);
  }
  .bp-brag {
    display: flex;
    flex-direction: column;
    gap: 0.2em;
    padding: 1.4em 1.6em;
    border-radius: 1.8em;
    background: linear-gradient(135deg, #b7ea7c, var(--lime));
  }
