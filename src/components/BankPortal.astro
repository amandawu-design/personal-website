---
// Animated concept for the digital bank case study, in two scenarios that
// auto-cycle (with tabs to switch and a pause button):
//   1. Trading: an order with take profit / stop loss is placed right on the
//      chart on desktop, then on mobile the take profit fills and the gain is
//      shared with a friend.
//   2. Family budget: a parent sets a monthly budget on desktop, then the
//      child gets a notification on their phone and opens the details.
//
// Everything inside the frame is sized in em, and 1em = 1/160 of the frame
// width, so the scene scales like an image. Each scenario runs once per play
// (--T); timings below are percentages of that. Without JS, or with
// prefers-reduced-motion, the static state shows each scenario's end screens.
//
// The desktop starts centred on its own; the phone only rises in when its
// first notification arrives, and the desktop slides left to make room.

import { createTimeline, type Point } from '../scripts/timeline';

const { n, kf, on, off, between, press, grow, settle, draw, toast, banner, dragLine, path, clicks, taps, css } = createTimeline();

// Desktop layout, in desktop em: content starts at X0, the panels under the page title at CT
const X0 = 3.6;
const CT = 17;
// Phone rises in from below the frame between a and b while the desktop slides from the centre to the left
const DESK_SHIFT = 15.5; // (160 - 104) / 2 - 12.5
const enter = (a: number, b: number) => ({
  desk: settle(a, b, `translateX(${DESK_SHIFT}em)`),
  phone: kf(`bp-phone-in-${String(a).replace('.', 'x')}`, `0%,${a}%{transform:translateY(80em)}${b}%,100%{transform:none}`),
});

/* ------------------------------------------------------------------ */
/* Scenario 2: family budget (16s)                                     */
/* ------------------------------------------------------------------ */

const BUDGET_T = '16s';
// Slider: $0–$150, dragged from $20 to $80. The track spans the 59em main column at CT + 20em.
const TRACK = 59;
const SLIDER_Y = CT + 20.3;
const thumbFrom = X0 + (20 / 150) * TRACK;
const thumbTo = X0 + (80 / 150) * TRACK;
const ACTIONS_Y = CT + 52.8; // switch and Save button centres (3.6em row at 51em)
const budgetCursor: Point[] = [
  [0, 84, 54],
  [5, thumbFrom, SLIDER_Y],
  [7.5, thumbFrom, SLIDER_Y],
  [19, thumbTo, SLIDER_Y],
  [24, X0 + 2.2, ACTIONS_Y],
  [26, X0 + 2.2, ACTIONS_Y],
  [31, X0 + TRACK - 7, ACTIONS_Y],
  [33, X0 + TRACK - 7, ACTIONS_Y],
  [40, 78, 72],
  [100, 78, 72],
];
const B = {
  cursor: path('bp-b-cursor', budgetCursor),
  cursorVis: between(1.5, 45),
  clicks: clicks('bp-b-clicks', [6.5, 25.5, 32.5]),
  thumb: settle(7.5, 19, `translateX(${n(thumbFrom - thumbTo)}em)`),
  fill: grow(7.5, 19, 0.25),
  amt20: off(11.3),
  amt40: between(11.3, 15.2),
  amt60: between(15.2, 19),
  amt80: on(19),
  cats: [grow(19.5, 25), grow(20.5, 26), grow(21.5, 27), grow(22.5, 28)],
  knob: settle(25.5, 27, 'translateX(-2em)'),
  switchOn: on(26),
  save: press(32.5),
  toast: toast(34, 46),
  ...enter(46.5, 50),
  banner: banner(51, 58.5),
  taps: taps('bp-b-taps', [[58, 14.1, 7.8]]),
  detail: settle(59.5, 63, 'translateY(100%)'),
  ring: draw(63, 72),
  mCats: [grow(66, 71), grow(67, 72), grow(68, 73), grow(69, 74)],
  note: on(73),
};

const budgetCats = [
  { name: 'Snacks', amount: 20, color: '#f2b9cf' },
  { name: 'Games', amount: 25, color: '#b9b6f0' },
  { name: 'Transport', amount: 20, color: '#f2d38a' },
  { name: 'Savings', amount: 15, color: '#86dc2a' },
];

/* ------------------------------------------------------------------ */
/* Scenario 1: trading (22s)                                           */
/* ------------------------------------------------------------------ */

const TRADE_T = '22s';

// Candlestick data: seeded random walk, identical every build
let seed = 11;
const rand = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
const N = 40;
const LAST = 1142.18;
const ENTRY = 1120;
const TP = 1180;
const SL = 1095;
const QTY = 10;
const walk: { open: number; close: number; high: number; low: number; vol: number }[] = [];
let price = 1000;
for (let i = 0; i < N; i++) {
  const open = price;
  const close = open + (rand() - 0.42) * 20;
  walk.push({ open, close, high: Math.max(open, close) + rand() * 8, low: Math.min(open, close) - rand() * 8, vol: 0.3 + rand() * 0.7 });
  price = close;
}
const candles = walk.map((c) => ({ ...c, open: c.open + LAST - price, close: c.close + LAST - price, high: c.high + LAST - price, low: c.low + LAST - price }));

// Chart geometry in SVG units; 10 units = 1em, so em positions line up with the HTML overlay.
const W = 550;
const TOP = 10;
const H = 260;
const VOL_TOP = 290;
const VOL_H = 56;
const lo = Math.min(...candles.map((c) => c.low), SL);
const hi = Math.max(...candles.map((c) => c.high), TP);
const min = lo - (hi - lo) * 0.08;
const max = hi + (hi - lo) * 0.08;
const step = hi - lo > 160 ? 50 : 25;
const ticks: number[] = [];
for (let v = Math.ceil(min / step) * step; v <= max; v += step) ticks.push(v);
const slot = W / N;
const cx = (i: number) => n(slot * i + slot / 2);
const cy = (v: number) => n(TOP + ((max - v) / (max - min)) * H);
const em = (u: number) => n(u / 10);
const PERIOD = 8;
const ma = candles.flatMap((_, i) =>
  i < PERIOD - 1 ? [] : [[cx(i), cy(candles.slice(i - PERIOD + 1, i + 1).reduce((s, c) => s + c.close, 0) / PERIOD)] as const],
);
const maPath = 'M' + ma.map(([x, y]) => `${x} ${y}`).join(' L');

// The chart overlay sits at desktop (X0, CT + 12em); Y() is a price level in desktop em.
const OX = X0;
const OY = CT + 12;
const Y = (v: number) => OY + em(cy(v));
const TP_HANDLE_X = OX + 40 + 2.3; // handle centres (handles sit at 40em and 45.5em, 4.6em wide)
const SL_HANDLE_X = OX + 45.5 + 2.3;
// Place order button centre (order ticket content is 29.8em wide at 70.6em)
const PLACE_X = 70.6 + 29.8 / 2;
const PLACE_Y = CT + 36.75;
const tradeCursor: Point[] = [
  [0, 86, 60],
  [5, OX + 34, Y(1150)],
  [10, OX + 20, Y(1132)],
  [15, OX + 38, Y(ENTRY)],
  [17, OX + 38, Y(ENTRY)],
  [21, TP_HANDLE_X, Y(ENTRY)],
  [23, TP_HANDLE_X, Y(ENTRY)],
  [30, TP_HANDLE_X, Y(TP)],
  [31, TP_HANDLE_X, Y(TP)],
  [34, SL_HANDLE_X, Y(ENTRY)],
  [36, SL_HANDLE_X, Y(ENTRY)],
  [41, SL_HANDLE_X, Y(SL)],
  [42, SL_HANDLE_X, Y(SL)],
  [46, PLACE_X, PLACE_Y],
  [48, PLACE_X, PLACE_Y],
  [53, 95, 72],
  [100, 95, 72],
];
const crosshair = tradeCursor.filter(([p]) => p <= 17);
const profit = (TP - ENTRY) * QTY;
const loss = (ENTRY - SL) * QTY;
const money = (v: number) => v.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const today = candles[N - 1];
const dayChange = 18.42; // the walk's last candle can close red; the header always shows an up day
const marketDetails = [
  ['Open', money(today.open)],
  ['Day high', money(Math.max(today.high, LAST))],
  ['Day low', money(today.low)],
  ['Volume', '38.6M'],
];

const T = {
  cursor: path('bp-t-cursor', tradeCursor),
  cursorVis: between(1.5, 54),
  clicks: clicks('bp-t-clicks', [17, 22.5, 35.5, 47.5]),
  vline: path('bp-t-vline', crosshair, (x) => `translateX(${n(x - OX)}em)`),
  hline: path('bp-t-hline', crosshair, (_, y) => `translateY(${n(y - OY)}em)`),
  crossVis: between(4, 16.8),
  buy: on(17.3),
  tpHandle: between(18.5, 22.5),
  slHandle: between(18.5, 35.5),
  tpLine: dragLine(22.5, 23, 30, em(cy(ENTRY) - cy(TP))),
  slLine: dragLine(35.5, 36, 41, em(cy(ENTRY) - cy(SL))),
  tpSet: on(30.5),
  slSet: on(41.5),
  dashEntry: off(17.5),
  entry: on(17.5),
  dashTp: off(30.5),
  dashSl: off(41.5),
  place: press(47.5),
  toast: toast(48.5, 60),
  ...enter(48.5, 52),
  live: on(52.5),
  liveBar: grow(53, 60, 0.35),
  p1: off(55),
  p2: between(55, 57.5),
  p3: on(57.5),
  banner: banner(61, 67.5),
  detail: settle(68.5, 72, 'translateY(100%)'),
  chart: draw(72, 78),
  share: press(79),
  sheet: settle(80.5, 83.5, 'translateY(100%)'),
  scrim: on(81),
  picked: on(87.5),
  send: press(91),
  sendLabel: off(92),
  sentLabel: on(92),
  taps: taps('bp-t-taps', [
    [67, 14.1, 7.8],
    [79, 14.1, 57.8],
    [87, 4.2, 48.6],
    [91, 14.1, 57.8],
  ]),
};

// Mini chart on the phone: price climbing from entry to take profit
const mini = [1121, 1118, 1126, 1124, 1133, 1130, 1141, 1146, 1143, 1155, 1161, 1158, 1169, 1175, 1180];
const miniY = (v: number) => n(8 + ((1186 - v) / (1186 - 1110)) * 84);
const miniPath = 'M' + mini.map((v, i) => `${n((i / (mini.length - 1)) * 236 + 2)} ${miniY(v)}`).join(' L');

const generatedCss = css();

const scenes = [
  {
    key: 'trade',
    tab: 'Trading',
    T: TRADE_T,
    label:
      'Animated concept: on desktop, an investor places a limit order with take profit and stop loss directly on a candlestick chart. On mobile, the take profit fills and they share the $600 gain with a friend.',
  },
  {
    key: 'budget',
    tab: 'Family budget',
    T: BUDGET_T,
    label:
      'Animated concept: on desktop, a parent sets an $80 monthly budget for their child. On the child’s phone, a notification arrives and opens the budget details.',
  },
];

const a = (name: string) => `--a:${name}`;
---

<div class="bp-root" data-bank-portal data-scene={scenes[0].key}>
  <div class="bp" role="img" aria-label={scenes[0].label} data-bp-frame>
    <div class="bp-stage" aria-hidden="true">
      <!-- ============================================================ -->
      <!-- Scenario 2: family budget                                    -->
      <!-- ============================================================ -->
      <div class="bp-scene bp-scene-budget" style={`--T:${BUDGET_T}`}>
        <div class="bp-desktop bp-a" style={a(B.desk)}>
          <div class="bp-nav">
            <span class="bp-brand"><span class="bp-logo"></span>QuestBank</span>
            <span class="bp-links">
              <span class="bp-link">Home</span>
              <span class="bp-link">Accounts</span>
              <span class="bp-link is-active">Family</span>
              <span class="bp-link">Trade</span>
            </span>
            <span class="bp-nav-end">
              <span class="bp-search"><svg class="bp-icon" viewBox="0 0 24 24"><circle cx="11" cy="11" r="6" /><path d="M20 20l-4.5-4.5" /></svg>Search</span>
              <span class="bp-icon-btn"><svg class="bp-icon" viewBox="0 0 24 24"><path d="M6 16V11a6 6 0 1 1 12 0v5l1.5 2h-15L6 16Zm4 4a2 2 0 0 0 4 0" /></svg></span>
              <span class="bp-avatar"><span>AW</span></span>
            </span>
          </div>
          <p class="bp-hello">Family budgets</p>

          <div class="bp-card bp-budget-card">
            <div class="bp-kid">
              <span class="bp-face bp-face-lg" style="--c:#f3cfdc"><span>M</span></span>
              <span class="bp-kid-text"><b>Maya</b><span>Age 12 · Prepaid card ••2291</span></span>
              <span class="bp-pill">October</span>
            </div>

            <p class="bp-muted bp-budget-label">Monthly budget</p>
            <p class="bp-budget-amount bp-swap">
              <span class="bp-a bp-hide" style={a(B.amt20)}>$20</span>
              <span class="bp-a bp-hide" style={a(B.amt40)}>$40</span>
              <span class="bp-a bp-hide" style={a(B.amt60)}>$60</span>
              <span class="bp-a" style={a(B.amt80)}>$80</span>
            </p>

            <div class="bp-slider">
              <span class="bp-slider-fill bp-a" style={a(B.fill)}></span>
              <span class="bp-slider-thumb bp-a" style={a(B.thumb)}></span>
            </div>
            <div class="bp-slider-scale"><span>$0</span><span>$150</span></div>

            <div class="bp-row bp-cats-head"><span class="bp-overline">Categories</span><span class="bp-muted">4 of 4 set</span></div>
            <div class="bp-cats">
              {budgetCats.map((c, i) => (
                <div class="bp-cat">
                  <span class="bp-dot" style={`--c:${c.color}`}></span>
                  <span class="bp-cat-name">{c.name}</span>
                  <span class="bp-cat-bar"><span class="bp-a" style={`${a(B.cats[i])};--c:${c.color};width:${(c.amount / 25) * 100}%`}></span></span>
                  <span class="bp-cat-amt">${c.amount}</span>
                </div>
              ))}
            </div>

            <div class="bp-budget-actions">
              <span class="bp-switch">
                <span class="bp-switch-on bp-a" style={a(B.switchOn)}></span>
                <span class="bp-switch-knob bp-a" style={a(B.knob)}></span>
              </span>
              <span class="bp-switch-label">Notify Maya when it’s ready</span>
              <span class="bp-btn bp-dark bp-save bp-a" style={a(B.save)}>Save budget</span>
            </div>
          </div>

          <div class="bp-card bp-side-card">
            <p class="bp-card-title">Maya’s goals</p>
            <div class="bp-goal">
              <div class="bp-row"><b>New bike</b><span class="bp-muted">$120 of $300</span></div>
              <span class="bp-progress-track"><span style="width:40%"></span></span>
            </div>
            <p class="bp-overline">Rules</p>
            <div class="bp-row bp-rule"><span>Weekly limit</span><b>$25<svg class="bp-chev" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6" /></svg></b></div>
            <div class="bp-row bp-rule"><span>Online purchases</span><b>Ask me<svg class="bp-chev" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6" /></svg></b></div>
            <div class="bp-row bp-rule"><span>Round-ups to savings</span><span class="bp-switch bp-switch-static"><span class="bp-switch-on"></span><span class="bp-switch-knob"></span></span></div>
            <p class="bp-overline">Recent activity</p>
            <div class="bp-row bp-rule"><span class="bp-txn"><b>Corner Store</b><span>Snacks · Today</span></span><b>−$4.50</b></div>
            <div class="bp-row bp-rule"><span class="bp-txn"><b>Allowance</b><span>From Mom · Sep 29</span></span><b class="bp-pos">+$10.00</b></div>
            <div class="bp-row bp-rule"><span class="bp-txn"><b>Transit pass</b><span>Transport · Sep 26</span></span><b>−$6.25</b></div>
          </div>

          <div class="bp-toast bp-a bp-hide" style={a(B.toast)}>
            <span class="bp-toast-icon"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></span>
            <span class="bp-toast-text"><b>Budget saved</b><span>Maya will get a notification</span></span>
          </div>

          <div class="bp-cursor bp-a" style={a(B.cursor)}>
            <div class="bp-a bp-hide" style={a(B.cursorVis)}>
              <span class="bp-ripple bp-a" style={a(B.clicks)}></span>
              <svg class="bp-arrow" viewBox="0 0 20 24"><path d="M2 2l15 11.5-6.6.9 3.8 7.3-2.7 1.4-3.8-7.4L2 20.5z" /></svg>
            </div>
          </div>
        </div>

        <div class="bp-phone bp-a" style={a(B.phone)}>
          <div class="bp-screen">
            <div class="bp-lock">
              <p class="bp-lock-date">Wednesday, October 1</p>
              <p class="bp-lock-time">9:41</p>
            </div>

            <div class="bp-app bp-a" style={a(B.detail)}>
              <div class="bp-app-head">
                <svg class="bp-icon" viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7" /></svg>
                <p class="bp-app-title">October budget</p>
              </div>
              <div class="bp-ring">
                <svg viewBox="0 0 120 120">
                  <circle class="bp-ring-track" cx="60" cy="60" r="50" />
                  <circle class="bp-ring-arc bp-a" style={a(B.ring)} cx="60" cy="60" r="50" pathLength="1" />
                </svg>
                <div class="bp-ring-text"><b>$80</b><span>left to spend</span></div>
              </div>
              <p class="bp-muted bp-center">30 days left · resets Nov 1</p>
              <div class="bp-m-cats">
                {budgetCats.map((c, i) => (
                  <div class="bp-m-cat">
                    <div class="bp-row"><span><i class="bp-dot" style={`--c:${c.color}`}></i>{c.name}</span><b>${c.amount}</b></div>
                    <span class="bp-cat-bar"><span class="bp-a" style={`${a(B.mCats[i])};--c:${c.color};width:${(c.amount / 25) * 100}%`}></span></span>
                  </div>
                ))}
              </div>
              <div class="bp-note bp-a" style={a(B.note)}>
                <span class="bp-face" style="--c:#d9cbb0"><span>AW</span></span>
                <span><b>Note from Mom</b><span>Save some for the movie on Friday!</span></span>
              </div>
            </div>

            <div class="bp-banner bp-a bp-hide" style={a(B.banner)}>
              <span class="bp-app-icon"></span>
              <span class="bp-banner-text">
                <span class="bp-row bp-banner-app"><span>QuestBank</span><span>now</span></span>
                <b>Your October budget is ready</b>
                <span>You have $80 to spend this month. Tap to see the details.</span>
              </span>
            </div>

            <div class="bp-status"><span class="bp-island"></span></div>
            <span class="bp-home"></span>
            <span class="bp-tap bp-a bp-hide" style={a(B.taps)}></span>
          </div>
        </div>
      </div>

      <!-- ============================================================ -->
      <!-- Scenario 1: trading                                           -->
      <!-- ============================================================ -->
      <div class="bp-scene bp-scene-trade" style={`--T:${TRADE_T}`}>
        <div class="bp-desktop bp-a" style={a(T.desk)}>
          <div class="bp-nav">
            <span class="bp-brand"><span class="bp-logo"></span>QuestBank</span>
            <span class="bp-links">
              <span class="bp-link">Home</span>
              <span class="bp-link">Accounts</span>
              <span class="bp-link">Family</span>
              <span class="bp-link is-active">Trade</span>
            </span>
            <span class="bp-nav-end">
              <span class="bp-search"><svg class="bp-icon" viewBox="0 0 24 24"><circle cx="11" cy="11" r="6" /><path d="M20 20l-4.5-4.5" /></svg>Search</span>
              <span class="bp-icon-btn"><svg class="bp-icon" viewBox="0 0 24 24"><path d="M6 16V11a6 6 0 1 1 12 0v5l1.5 2h-15L6 16Zm4 4a2 2 0 0 0 4 0" /></svg></span>
              <span class="bp-avatar"><span>AW</span></span>
            </span>
          </div>
          <p class="bp-hello">Welcome back, Amanda!</p>

          <div class="bp-card bp-chart-card">
            <div class="bp-chart-head">
              <div>
                <p class="bp-sym"><span class="bp-ticker">N</span><b>NVDA</b><span>NVIDIA Corp</span></p>
                <p class="bp-price">${money(LAST)}<small>USD</small></p>
                <p class="bp-change">+${money(dayChange)} (+{((dayChange / (LAST - dayChange)) * 100).toFixed(2)}%) today</p>
              </div>
              <div class="bp-chips">
                <span class="bp-chip"><i class="bp-swatch"></i>MA 8</span>
                <span class="bp-chip">Volume</span>
                <span class="bp-chip">Draw order</span>
              </div>
            </div>

            <svg class="bp-svg" viewBox={`0 0 610 ${VOL_TOP + VOL_H + 10}`}>
              {ticks.map((v) => (
                <g>
                  <line class="bp-gridline" x1="0" x2={W} y1={cy(v)} y2={cy(v)} />
                  <text class="bp-axis" x={W + 8} y={cy(v) + 4}>{v.toLocaleString('en-US')}</text>
                </g>
              ))}
              <line class="bp-gridline" x1="0" x2={W} y1={VOL_TOP - 6} y2={VOL_TOP - 6} />
              {candles.map((c, i) => (
                <rect
                  class:list={['bp-vol', c.close >= c.open ? 'is-up' : 'is-down']}
                  style={`--i:${i}`}
                  x={cx(i) - 4}
                  y={n(VOL_TOP + VOL_H * (1 - c.vol))}
                  width="8"
                  height={n(VOL_H * c.vol)}
                />
              ))}
              {candles.map((c, i) => (
                <g class:list={['bp-candle', c.close >= c.open ? 'is-up' : 'is-down']} style={`--i:${i}`}>
                  <line x1={cx(i)} x2={cx(i)} y1={cy(c.high)} y2={cy(c.low)} />
                  <rect x={cx(i) - 4} y={cy(Math.max(c.open, c.close))} width="8" height={Math.max(1.5, n(Math.abs(cy(c.open) - cy(c.close))))} rx="1" />
                </g>
              ))}
              <path class="bp-ma" d={maPath} />
            </svg>

            <div class="bp-seg"><span>1D</span><span>1W</span><span>1M</span><span class="is-on">3M</span><span>YTD</span><span>All</span></div>
            <div class="bp-details">
              <p class="bp-details-title">Market details</p>
              {marketDetails.map(([k, v]) => (
                <p><span class="bp-muted">{k}</span><b>{v}</b></p>
              ))}
            </div>

            <!-- Order lines and crosshair, drawn in em over the chart (1em = 10 chart units) -->
            <div class="bp-overlay">
              <div class="bp-level bp-level-last" style={`top:${em(cy(LAST))}em`}><span class="bp-tag">{money(LAST)}</span></div>

              <div class="bp-zone bp-zone-tp bp-a" style={`${a(T.tpSet)};top:${em(cy(TP))}em;height:${em(cy(ENTRY) - cy(TP))}em`}></div>
              <div class="bp-zone bp-zone-sl bp-a" style={`${a(T.slSet)};top:${em(cy(ENTRY))}em;height:${em(cy(SL) - cy(ENTRY))}em`}></div>

              <div class="bp-level bp-level-buy bp-a" style={`${a(T.buy)};top:${em(cy(ENTRY))}em`}>
                <span class="bp-label">Buy limit · {QTY}</span>
                <span class="bp-handle bp-a bp-hide" style={`${a(T.tpHandle)};left:40em`}>+ TP</span>
